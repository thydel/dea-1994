@Article{Fox94,
  author =       "Geoffrey C. Fox\mymarginpar{Fox94}",
  title =        "Parallel Computers and Complex Systems",
  journal =      "Complexity International",
  year =         "1994",
  volume =       "1",
  month =        apr,
  note =         Fox94:note,
  where =        "internet",
  url =          Fox94:URL,
  refcnt =       "26",
  email =        "\email{gcf}{nova.npac.syr.edu}",
  abstract =     "We consider parallel computing as the mapping of one
                 complex system - typically a model of the world - into
                 another complex system - the parallel computer. We
                 study static, dynamic, spatial and temporal properties
                 of both the complex systems and the map between them.
                 The result is a better understanding of which computer
                 architectures are good for which problems, software
                 structure, automatic partitioning of data and
                 performance of parallel machines.",
  date =         "aug94",
}

@string{Green94:URL = "http://life.anu.edu.au/ci/vol1/David.Green/paper.html"}
@string{Green94:note = "\footnotesize ISSN 1320-0682. \\
                        \texttt{http://life.anu.edu.au/ci/vol1/David.Green/paper.html}
                        \normalsize"}
@Article{Green94,
  author =       "David G. Green\mymarginpar{Green94}",
  title =        "Emergent Behaviour in Biological Systems",
  journal =      "Complexity International",
  year =         "1994",
  volume =       "1",
  month =        apr,
  note =         Green94:note,
  where =        "internet",
  url =          Green94:URL,
  refcnt =       "25",
  email =        "\email{david.green}{anu.edu.au}",
  abstract =     "Underlying many kinds of emergent behaviour in biology
                 are the critical changes in connectivity that occur as
                 links increase between the elements of a system. The
                 behaviour of systems with near-critical connectivity is
                 essentially chaotic and may be an important source of
                 variety in biology. In most models of biological
                 systems (e.g. dynamical systems, cellular automata,
                 state spaces) the patterns of connectivity between
                 elements are isomorphic to directed graphs. These
                 isomorphisms suggest that the above sources of emergent
                 behaviour may be universal.",
  date =         "aug94",
}
