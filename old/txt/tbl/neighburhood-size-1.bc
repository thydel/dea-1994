/* scale=10 */

roff=0
latex=1
dcolumn=0

kilo = 1024
mega = kilo*kilo
giga = kilo*mega
tera = kilo*giga

define print_big(n) {
	oscale = scale
	scale = 0
	if (n >= tera) {
		print n / tera, "T"
	} else if (n >= giga) {
		print n / giga , "G"
	} else if (n >= mega) {
		print n / mega, "M"
	} else if (n >= kilo) {
		print n / kilo, "K"
	} else if (n == 0) {
		print 1
	} else {
		print n
	}
	scale = oscale
	return
}

define print_res(n) {
	if (roff) {
		if ((n - 3) < 30) {
			print "\\fB"
			discard = print_big(2^(n - 3))
			print "\\fR"
		} else {
			print "\\s-2\\fI"
			discard = print_big(2^(n - 3))
			print "\\s+2\\fR"
		}
	}
	if (latex) {
		if ((n - 3) < 30) {
			print "\\textbf{"
			discard = print_big(2^(n - 3))
			print "}"
		} else {
			print "\\textit{\\small"
			discard = print_big(2^(n - 3))
			print "}"
		}
	}
	return
}

define nvoisin(dim, dist) {
	return ((2 * dist * dim) + 1)
}

/* columns */
ndim = 4
/* lines */
from_dist = 1
to_dist = 4
ndist = (to_dist - from_dist) + 1

if (roff) {
	print ".TS\n"

	print "center allbox;\n"
}

/*
 * TBL desc
 */

if (roff) {
	/* lines titles */
	print "c\ts\tc"
	for (dist = 0; dist < ndist - 1; ++dist) {
		print "\ts"
	}
	print "\n"
	
	/* line values */
	print "^\t^"
	for (dist = 0; dist < ndist; ++dist) {
		print "\tn"
	}
	print "\n"
	
	/* first two data lines */
	print "c\tn"
	for (dist = 0; dist < ndist; ++dist) {
		print "\tn"
	}
	print "\n"
	print "^\tn"
	for (dist = 0; dist < ndist; ++dist) {
		print "\tn"
	}
	print ".\n"
}

if (latex) {
	if (dcolumn) {
		if (0) {
			print "\\newcolumntype{.}{D{.}{\\,}{-1}}\n"
		} else {
			print "\\newcolumntype{.}{D{.}{}{-1}}\n"
		}
	}
	print "\\begin{tabular}{|c|c"
	for (dist = 0; dist < to_dist; ++dist) {
		if (dcolumn) {
			print "|."
		} else {
			print "|c"
		}
	}
	print "|} \\hline"
	print "\n\n"
}

/*
 * TBL datas
 */

if (roff) {
	/* first line (line X col title and line title) */
	print "$2 sup { 2 n d - 2 }$\t$n$\n"
}

if (latex) {
	print "\\multicolumn{2}{|c}{} &%"
	print "\n"
	print " \\multicolumn{", to_dist, "}{|c|}{$n$}%"
	print "\n"
	print " \\\\\\cline{3-", to_dist + 2, "}\n\n"
	print "    \\multicolumn{2}{|c|}{\\raisebox{1.5ex}[0cm][0cm]%\n"
	print "    {$2^{2nd-2}$}}\n"
}

if (roff) {
	/* second line (line args values) */
	print "\t"
	for (dist = from_dist; dist <= to_dist; ++dist) {
		print "\t", dist
	}
	print "\n"
}

if (latex) {
	for (dist = from_dist; dist <= to_dist; ++dist) {
		print " & " 
		print dist
	}
	print "\\\\\\hline\n\n"
}

if (roff) {
	/* third line (columns title and first line values) */
	print "$d$\t"
	dimension = 1
	print dimension, "\t"
	for (dist = from_dist; dist <= to_dist; ++dist) {
		discard = print_res(nvoisin(dimension, dist))
		print "\t"
	}
	print "\n"
}

if (latex) {
	/* first line */
	dimension = 1
	print " & ", dimension, " & "
	for (dist = from_dist; dist <= to_dist; ++dist) {
		discard = print_res(nvoisin(dimension, dist))
		if (dist != to_dist) {
			print " & "
		} else {
			print " "
		}
	}
	print "%\n\\\\\\cline{2-", to_dist + 2, "}\n"
}

if (roff) {
	/* other lines */
	for (dimension = 2; dimension <= ndim; ++dimension) {
		print "\t", dimension, "\t"
		for (dist = from_dist; dist <= to_dist; ++dist) {
			discard = print_res(nvoisin(dimension, dist))
			print "\t"
		}
		print "\n"
	}
}

if (latex) {
	/* middle lines */
	for (dimension = 2; dimension < ndim; ++dimension) {
		if (dimension > ndim / 2) {
			print "\\raisebox{1.5ex}[0cm][0cm]{"
			print "$d$"
			print "}%\n"
		}		
		print " & ", dimension, " & "
		for (dist = from_dist; dist <= to_dist; ++dist) {
			discard = print_res(nvoisin(dimension, dist))
			if (dist != to_dist) {
				print " & "
			} else {
				print " "
			}
		}
		print "\\\\\\cline{2-", to_dist + 2, "}\n"
	}
	/* last line */
	print " & ", dimension, " & "
	for (dist = from_dist; dist <= to_dist; ++dist) {
		discard = print_res(nvoisin(dimension, dist))
		if (dist != to_dist) {
			print " & "
		} else {
			print " "
		}
	}
	print "%\n\\\\\\hline\n"
}

if (roff) {
	print ".TE\n"
}

if (latex) {
	print "\\end{tabular}\n"
}
