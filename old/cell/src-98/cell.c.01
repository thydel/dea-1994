#else

#define MOORE_T_8_SIZE (1 << 12 + 8)

#define MOORE_T_8 \
    w_index = north[side - 1] + center[side - 1] + south[side - 1]; \
    c_index = *north++ + (c1 = *center++) + *south++; \
    e_index = *north++ + (c2 = *center++) + *south++; \
    index = (w_index + c_index + e_index); \
    *futur++ = TRANSITION(index - c1 | c1 << 12); \
