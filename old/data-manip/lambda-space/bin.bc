define main(n) {
	auto i, nn, saved_scale

	saved_scale = scale

	scale = 5
	nn = 2^n
	for (i = 0; i < nn; ++i) {
 		one_cnt[i] = one_cnt(n, i)
		flip_cnt[i] = flip_cnt(n, i)
	}
	for (i = 1; i < nn; ++i) {
 		one_cnt_diff[i] = one_cnt[i] - one_cnt[i - 1]
 		flip_cnt_diff[i] = flip_cnt[i] - flip_cnt[i - 1]
	}
	for (i = 0; i < nn; ++i) {
 		one_cnt_ratio[i] = one_cnt[i] / n
		flip_cnt_ratio[i] = flip_cnt[i] / n
	}
	for (i = 0; i < nn; ++i) {
 		sum_cnt_ratio[i] = (one_cnt_ratio[i] + flip_cnt_ratio[i]) / 2
	}
	for (i = 1; i < nn; ++i) {
 		one_cnt_ratio_diff[i] = one_cnt_ratio[i] - one_cnt_ratio[i - 1]
 		flip_cnt_ratio_diff[i] = flip_cnt_ratio[i] - flip_cnt_ratio[i - 1]
	}
	for (i = 0; i < nn; ++i) {
		discard = ++one_cnt_hist[one_cnt[i]]
		discard = ++flip_cnt_hist[flip_cnt[i]]
	}
	for (i = 0; i <= n; ++i) {
		one_cnt_hist_ratio[i] = one_cnt_hist[i] / nn
		flip_cnt_hist_ratio[i] = flip_cnt_hist[i] / nn
	}
	for (i = 0; i < nn; ++i) {
		one_cnt_prob[i] = one_cnt_hist[one_cnt[i]] / nn
		flip_cnt_prob[i] = flip_cnt_hist[flip_cnt[i]] / nn
	}
	for (i = 1; i < nn; ++i) {
		one_cnt_prob_diff[i] = one_cnt_prob[i] - one_cnt_prob[i - 1]
		flip_cnt_prob_diff[i] = flip_cnt_prob[i] - flip_cnt_prob[i - 1]
	}
	discard = do_print()

	scale = saved_scale
}

