	}
		print "\n"
	}

	obase = saved_obase
}

define evenp(n) {
	return (n % 2)
}

define one_cnt(cnt, pat) {
	auto i, sum, saved_scale

	saved_scale = scale

	scale = 0
	for (i = 0; i < cnt; ++i) {
		if (evenp(pat)) {
			sum = sum + 1
		}
		pat = pat / 2
	}

	scale = saved_scale

	return (sum)
}

define flip_cnt(cnt, pat) {
	auto i, first, prev, current, sum, saved_scale

	saved_scale = scale

	scale = 0
	first = prev = evenp(pat)
	pat = pat / 2
	for (i = 1; i < cnt; ++i) {
		current = evenp(pat)
		if (current != prev) {
			sum = sum + 1
		}
		prev = current
		pat = pat / 2
	}
	if (current != first) {
		sum = sum + 1
	}

	scale = saved_scale

	return (sum)
}

discard = main(14)
quit
