	auto saved_obase

	saved_obase = obase

	for (i = 0; i < nn; ++i) {

	if (0) {
		obase = 10
		print i
		print "\t"
		obase = 2
		print i
		print "\t"
		obase = 10
	}
	if (1) {
		print i
		print "\t"
 		print one_cnt[i]
		print "\t"
		print flip_cnt[i]
		print "\t"
 		print one_cnt_diff[i]
		print "\t"
		print flip_cnt_diff[i]
		print "\t"
 		print one_cnt_ratio[i]
		print "\t"
		print flip_cnt_ratio[i]
		print "\t"
 		print one_cnt_ratio_diff[i]
		print "\t"
		print flip_cnt_ratio_diff[i]
		print "\t"
		print one_cnt_prob[i]
		print "\t"
		print flip_cnt_prob[i]
		print "\t"
		print one_cnt_prob_diff[i]
		print "\t"
		print flip_cnt_prob_diff[i]
		print "\t"
 		print one_cnt_hist[i]
		print "\t"
		print flip_cnt_hist[i]
		print "\t"
 		print one_cnt_hist_ratio[i]
		print "\t"
		print flip_cnt_hist_ratio[i]	
