(cd $1; for i in relative-???.pgm; do mv $i `echo $i | sed -e 's/relative/rel/'`; done)

#(cd $1; rm -f trans-yxz-?.pgm trans-zyx-?.pgm trans-zxy-?.pgm)
(cd $1; for i in trans-???-?.pgm; do mv $i `echo $i | sed -e 's/trans/Trans/'`; done)
(cd $1; for i in Trans-???-?.pgm; do pnmflip -tb $i > `echo $i | sed -e 's/Trans/trans/'`;done)
