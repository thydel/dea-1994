changequote([,])

define([set_frame],[
	gapp c := ns
	gapp ram $1 := c
	zone2ascii 24 8
	print
])


define([base], 29)
define([ram0], base)
define([ram1], eval(base + 1))
define([ram2], eval(base + 2))

single
set_frame(ram0)

bloc 4
set_frame(ram1)

random
set_frame(ram2)

print --------------------

define([get_frame],[
	gapp ns := ram $1
	state2ascii 1
	print
])

gapp ns := 0; ew := 0; c := 0
state2ascii 1
print

get_frame(ram0)
get_frame(ram1)
get_frame(ram2)
