#define NACTION 8

Simple2D* Simple2D_new(Time2D* time) {
    Simple2D* zis;
    int i;

    assert(time && time->magic == magic(TIME_2D));
    zis = (Simple2D*)malloc(sizeof(Simple2D));
    assert(zis);
    zis->magic = magic(SIMPLE_2D);
    zis->handle = 0;
    zis->name = 0;
    zis->time = time;
    Time2D_get_space(zis->time, &zis->past, &zis->futur);
    zis->func = 0;
    zis->naction = NACTION;
    zis->action = (Action**)malloc(sizeof(Action*) * zis->naction);
    assert(zis->action);
    for (i = 0; i < zis->naction; ++i) {
	zis->action[i] = 0;
    }
    zis->staton = false;
    return zis;
}

int cmd_Simple2D_new(ClientData notUsed, Tcl_Interp* interp, int ac, char** av) {
    static char* usage = "Time2D";

    Simple2D* zis;
    Time2D* time;
    
    void* ptr;
    char handle[64];

    if (ac != 2) {
	Tcl_AppendResult(interp, "bad # arg: ", av[0], " ", usage, 0);
	return TCL_ERROR;
    }
    
    time = *(Time2D**)Tcl_HandleXlate(interp, Time_tbl, av[1]);
    if (!time) {
	return TCL_ERROR;
    }

    zis = Simple2D_new(time);

    Tcl_HandleAlloc(Simple_tbl, handle);
    ptr = Tcl_HandleXlate(interp, Simple_tbl, handle);
    assert(ptr);

    *(Simple2D**)ptr = zis;

    strcpy(interp->result, handle);
    return TCL_OK;
}

