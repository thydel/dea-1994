	    }
#endif

void Simple2D_action(Simple2D* zis, Action* action, int n) {
    assert(zis && zis->magic == magic(SIMPLE_2D) &&
	   action && action->magic == magic(ACTION) &&
	   n < zis->naction);
    zis->action[n] = action;
}

void Simple2D_func(Simple2D* zis, Func* func) {
    assert(zis && zis->magic == magic(SIMPLE_2D) &&
	   func && func->magic == magic(FUNC));
    zis->func = func;
}

bool Simple2D_step(Simple2D* zis) {
    int i;

    assert(zis && zis->magic == magic(SIMPLE_2D));

    /* space time full, user must free something */
    if (Time2D_full(zis->time)) {
	return false;
    }

    /* get current space point */
    Time2D_get_space(zis->time, &zis->past, &zis->futur);

    /* call back each action */
    for (i = 0; i < zis->naction; ++i) {
	Action_trigger(zis->action[i]);
    }

    /* compute next state */
    if (zis->futur->time < zis->past->time) {
	if (!zis->staton) {
	    zis->func->spec->apply(zis->func->tab,
				   zis->past->state,
				   zis->futur->state);
	} else {
	    zis->func->spec->apply(zis->func->tab,
				   zis->past->state,
				   zis->futur->state,
				   zis->func->sum,
				   &zis->futur->sum,
				   zis->futur->time_sum);
	}
    }

    /* go to next time step */
    Time2D_next(zis->time);
}

